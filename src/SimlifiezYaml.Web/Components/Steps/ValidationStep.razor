@inject WizardState Wizard

<h2>Validation</h2>
@if (Wizard.GenerationError != null)
{
    <div class="severity-error generation-error"><pre>@Wizard.GenerationError</pre></div>
}
else if (Wizard.Result is { } result)
{
    if (result.ValidationResults.Count == 0)
    {
        <p class="severity-info">No issues found.</p>
    }
    else
    {
        foreach (var group in result.ValidationResults.GroupBy(v => v.Severity).OrderByDescending(g => g.Key))
        {
            <h3 class="severity-@group.Key.ToString().ToLowerInvariant()">@group.Key (@group.Count())</h3>
            <ul class="validation-list">
                @foreach (var v in group)
                {
                    <li class="severity-@v.Severity.ToString().ToLowerInvariant()">
                        @v.Message
                        @if (!string.IsNullOrWhiteSpace(v.SuggestedFix))
                        {
                            <div class="hint">Fix: @v.SuggestedFix</div>
                        }
                    </li>
                }
            </ul>
        }
    }
}
