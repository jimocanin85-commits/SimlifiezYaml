@page "/"
@rendermode InteractiveServer
@inject WizardState Wizard
@inject IPipelineGeneratorService Generator

<PageTitle>SimlifiezYaml - Pipeline Builder</PageTitle>

<div class="wizard">
    <nav class="wizard-nav" aria-label="Wizard steps">
        @foreach (var step in Enum.GetValues<WizardStep>())
        {
            <button type="button" class="step-btn @(Wizard.CurrentStep == step ? "active" : "")"
                    data-step="@step" aria-current="@(Wizard.CurrentStep == step ? "step" : null)"
                    @onclick="() => GoTo(step)">
                @((int)step). @StepTitles.For(step)
            </button>
        }
    </nav>

    <section class="wizard-content">
        @* Input* components need a cascading EditContext, so every step renders inside this form. *@
        <EditForm Model="Wizard.Definition">
            @switch (Wizard.CurrentStep)
            {
                case WizardStep.ProjectType:
                    <ProjectTypeStep />
                    break;
                case WizardStep.BuildAgent:
                    <BuildAgentStep />
                    break;
                case WizardStep.PipelineTemplate:
                    <TemplateStep />
                    break;
                case WizardStep.EnvironmentSelection:
                    <EnvironmentsStep />
                    break;
                case WizardStep.DeploymentTarget:
                    <DeploymentTargetStep />
                    break;
                case WizardStep.IdentityModel:
                    <IdentityStep />
                    break;
                case WizardStep.VariableGroupsAndKeyVault:
                    <VariablesStep />
                    break;
                case WizardStep.ArtifactSettings:
                    <ArtifactStep />
                    break;
                case WizardStep.RollbackSettings:
                    <RollbackStep />
                    break;
                case WizardStep.HealthChecks:
                    <HealthChecksStep />
                    break;
                case WizardStep.Notifications:
                    <NotificationsStep />
                    break;
                case WizardStep.GovernancePolicies:
                    <GovernanceStep />
                    break;
                case WizardStep.YamlPreview:
                    <PreviewStep />
                    break;
                case WizardStep.ValidationResults:
                    <ValidationStep />
                    break;
                case WizardStep.DownloadExport:
                    <ExportStep />
                    break;
            }
        </EditForm>
    </section>

    <footer class="wizard-footer">
        <button type="button" disabled="@(Wizard.CurrentStep == WizardStep.ProjectType)" @onclick="Prev">Previous</button>
        <button type="button" disabled="@(Wizard.CurrentStep == WizardStep.DownloadExport)" @onclick="Next">Next</button>
    </footer>
</div>

@code {
    private void Prev() => GoTo((WizardStep)Math.Max((int)WizardStep.ProjectType, (int)Wizard.CurrentStep - 1));
    private void Next() => GoTo((WizardStep)Math.Min((int)WizardStep.DownloadExport, (int)Wizard.CurrentStep + 1));

    private void GoTo(WizardStep step)
    {
        Wizard.CurrentStep = step;
        // Preview, validation and export always reflect the current settings.
        if (step >= WizardStep.YamlPreview)
            Wizard.Generate(Generator);
    }
}
